<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="交前一查 · 比赛材料预检" Width="1110" Height="790" MinWidth="800" MinHeight="570" WindowStartupLocation="CenterScreen" Background="#F4F5F0" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#193D36" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#22483E"/><Setter Property="Background" Value="#F1F5EF"/><Setter Property="BorderBrush" Value="#C9D9CE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#639F83"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#EC9748"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#205745"/><Setter Property="BorderBrush" Value="#205745"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="20"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#D9E2D8"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#516B60"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Margin="24,16,24,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#58956B" Margin="0,0,7,0"/><TextBlock Style="{StaticResource Caption}" Text="本地工作台  /  图形预览版"/></StackPanel><StackPanel Orientation="Horizontal"><Border Background="#1D5143" Padding="6" CornerRadius="6" Margin="0,0,9,0"><Path Stroke="#F3C98F" StrokeThickness="2" Data="M1,7 L5,11 L13,2"/></Border><TextBlock Text="交前一查" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="#153F35" Padding="22,15" CornerRadius="12" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="SUBMISSION CHECK   /   评审工作台" FontSize="11" Foreground="#ACD0BB" FontWeight="SemiBold"/><TextBlock Text="比赛材料预检" Foreground="#FFFDF5" FontSize="29" FontWeight="Bold" Margin="0,2,0,3"/><TextBlock Text="先确认比赛规则，再检查提交文件。" Foreground="#D1E3D6" FontSize="13"/></StackPanel>
      <Viewbox Grid.Column="1" Width="89" Height="70" Margin="8,0,20,0" IsHitTestVisible="False"><Canvas Width="89" Height="70"><Path Fill="#366652" Data="M7 7 L53 2 L59 52 L13 57 Z"/><Path Fill="#9ABE9D" Data="M16 8 L60 8 L60 59 L16 59 Z"/><Path Fill="#F6E8C9" Data="M23 15 L61 15 L69 23 L69 64 L23 64 Z"/><Path Stroke="#718F7A" StrokeThickness="2.5" Data="M31 29 H54 M31 36 H59 M31 43 H50"/><Ellipse Canvas.Left="51" Canvas.Top="40" Width="28" Height="28" Fill="#E8A460"/><Path Stroke="#254637" StrokeThickness="2.7" Data="M57 54 L62 59 L72 48"/></Canvas></Viewbox>
      <Button Grid.Column="2" x:Name="Demo" Content="体验两赛对照  →" VerticalAlignment="Center" Background="#F3D7A7" BorderBrush="#F3D7A7" Padding="16,10"/></Grid></Border>
    <Grid Grid.Row="2" x:Name="Body"><Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="17,16,17,18">
        <Border Background="#EDF4ED" BorderBrush="#CCE0CE" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,10"><StackPanel>
          <DockPanel><Button x:Name="Probe" DockPanel.Dock="Right" Content="刷新" Padding="8,2" FontSize="11"/><TextBlock Text="模型连接" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
          <TextBlock x:Name="LocalState" Text="初读 / 正在检测本机 Ollama…" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
          <TextBlock x:Name="DshState" Text="复核 / 正在检测 DSH 桥…" Style="{StaticResource Caption}"/>
          <TextBlock x:Name="LastReply" Style="{StaticResource Caption}" Visibility="Collapsed"/>
          <TextBlock x:Name="ApiState" Style="{StaticResource Caption}" Visibility="Collapsed"/>
          <Button x:Name="ConnectAi" Content="接入我的 AI…" HorizontalAlignment="Left" Padding="9,3" Margin="0,5,0,0"/>
        </StackPanel></Border>
        <TextBlock Text="01   导入比赛通知" Style="{StaticResource Section}"/><TextBlock Text="支持 TXT、Markdown 和有文字的 Word。" Style="{StaticResource Caption}" Margin="0,4,0,9"/>
        <WrapPanel><Button x:Name="PickNotice" Content="选择通知文件" Style="{StaticResource Primary}" Margin="0,0,7,4"/><Button x:Name="Paste" Content="粘贴正文" Margin="0,0,0,4"/></WrapPanel>
        <TextBlock x:Name="NoticeLabel" Text="尚未选择通知" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
        <StackPanel x:Name="TrackBox" Visibility="Collapsed" Margin="0,8,0,0"><Label Content="适用范围" Padding="0,0,0,3" Target="{Binding ElementName=Track}"/><ComboBox x:Name="Track" MinHeight="29"/></StackPanel>
        <Separator Margin="0,12,0,11" Background="#DFE7DE"/>
        <TextBlock Text="02   确认检查规则" Style="{StaticResource Section}"/>
        <CheckBox x:Name="LocalPlan" Content="用本机 9B 识别材料（取消则仅用规则）" IsChecked="False" FontSize="12" Margin="0,5,0,8"/>
        <WrapPanel><Button x:Name="Plan" Content="生成任务清单" IsEnabled="False" Margin="0,0,6,0"/><Button x:Name="Inspect" Content="核对规则…" IsEnabled="False"/></WrapPanel>
        <CheckBox x:Name="Confirm" Content="我已核对清单，同意按这些规则检查" IsEnabled="False" FontSize="12" Margin="0,9,0,0"/>
        <Separator Margin="0,12,0,11" Background="#DFE7DE"/>
        <TextBlock Text="03   检查提交文件夹" Style="{StaticResource Section}"/>
        <TextBlock Text="只读检查，不修改作品，也不会代交。" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
        <WrapPanel><Button x:Name="PickFolder" Content="选择文件夹" Margin="0,0,7,4"/><Button x:Name="Audit" Style="{StaticResource Primary}" Content="开始预检  →" IsEnabled="False" Margin="0,0,0,4"/></WrapPanel>
        <TextBlock x:Name="FolderLabel" Text="尚未选择文件夹" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
      </StackPanel></ScrollViewer></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><Border DockPanel.Dock="Right" Background="#E8EFE7" Padding="8,3" CornerRadius="10"><TextBlock x:Name="Badge" Text="未开始" FontSize="11"/></Border><TextBlock x:Name="Kicker" Text="WORKSPACE   /   预检工作区" Foreground="#547665" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,12"><TextBlock x:Name="Title" Text="从一份比赛通知开始" FontWeight="Bold" FontSize="24" TextWrapping="Wrap"/><TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="2" x:Name="Scroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Cards"/></ScrollViewer>
        <WrapPanel Grid.Row="3" Margin="0,9,0,0"><Button x:Name="Review" Content="人工复核…" Visibility="Collapsed" Margin="0,0,6,0"/><Button x:Name="Report" Content="打开完整报告 ↗" Visibility="Collapsed" Margin="0,0,6,0"/><Button x:Name="Back" Content="回到我的清单" Visibility="Collapsed"/></WrapPanel>
      </Grid></Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="1,8,1,0"><TextBlock DockPanel.Dock="Right" Text="交前一查    /    DESKTOP" Foreground="#667A6E" FontSize="10" Margin="12,0,0,0"/><TextBlock x:Name="Status" Text="就绪 · 离线预检无需账号" Style="{StaticResource Caption}"/></DockPanel>
  </Grid>
</Window>
